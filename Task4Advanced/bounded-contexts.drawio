<mxfile host="app.diagrams.net"><diagram id="bounded-contexts" name="bounded-contexts"><mxGraphModel dx="1600" dy="950" grid="1" gridSize="10" pageWidth="2000" pageHeight="1050"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="" style="rounded=1;fillColor=none;dashed=1;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="300" height="330" as="geometry"/></mxCell><mxCell id="n3" value="Домен «Финтех»" style="text;fontStyle=2;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="70" y="96" width="260" height="24" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Кредитование&lt;/b&gt;&lt;br&gt;контекст: заявка → договор →&lt;br&gt;график → взыскание" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="130" width="260" height="80" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Платежи и счета&lt;/b&gt;&lt;br&gt;контекст: транзакции,&lt;br&gt;проводки, клиринг" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="230" width="260" height="80" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;…&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="330" width="80" height="70" as="geometry"/></mxCell><mxCell id="n7" value="" style="rounded=1;fillColor=none;dashed=1;" vertex="1" parent="1"><mxGeometry x="440" y="90" width="300" height="330" as="geometry"/></mxCell><mxCell id="n8" value="Домен «Клиники»" style="text;fontStyle=2;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="450" y="96" width="260" height="24" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Пациентский поток&lt;/b&gt;&lt;br&gt;контекст: запись, приём,&lt;br&gt;направления" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=10;" vertex="1" parent="1"><mxGeometry x="460" y="130" width="260" height="80" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Медицинские данные&lt;/b&gt;&lt;br&gt;контекст: карты, исследования&lt;br&gt;(ИЗОЛИРОВАН — не для аналитики)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=10;" vertex="1" parent="1"><mxGeometry x="460" y="230" width="260" height="80" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Операционный учёт&lt;/b&gt;&lt;br&gt;контекст: услуги, тарифы" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=10;" vertex="1" parent="1"><mxGeometry x="460" y="330" width="260" height="70" as="geometry"/></mxCell><mxCell id="n12" value="" style="rounded=1;fillColor=none;dashed=1;" vertex="1" parent="1"><mxGeometry x="820" y="90" width="300" height="260" as="geometry"/></mxCell><mxCell id="n13" value="Домен «ИИ-сервисы»" style="text;fontStyle=2;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="830" y="96" width="260" height="24" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Диагностика (inference)&lt;/b&gt;&lt;br&gt;контекст: обработка снимков,&lt;br&gt;результаты ИИ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=10;" vertex="1" parent="1"><mxGeometry x="840" y="130" width="260" height="80" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Обучение моделей (MLOps)&lt;/b&gt;&lt;br&gt;контекст: датасеты (обезличенные),&lt;br&gt;версии, эксперименты" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=10;" vertex="1" parent="1"><mxGeometry x="840" y="230" width="260" height="90" as="geometry"/></mxCell><mxCell id="n16" value="" style="rounded=1;fillColor=none;dashed=1;" vertex="1" parent="1"><mxGeometry x="1200" y="90" width="300" height="260" as="geometry"/></mxCell><mxCell id="n17" value="Домен «Головной офис»" style="text;fontStyle=2;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="1210" y="96" width="260" height="24" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;Финансы и отчётность&lt;/b&gt;&lt;br&gt;контекст: консолидация" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1220" y="130" width="260" height="80" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;HR и инвентарь&lt;/b&gt;&lt;br&gt;контекст: персонал, клиники,&lt;br&gt;оборудование" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1220" y="230" width="260" height="90" as="geometry"/></mxCell><mxCell id="n20" value="" style="rounded=1;fillColor=none;dashed=1;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="1440" height="210" as="geometry"/></mxCell><mxCell id="n21" value="Платформа (поддерживающие контексты)" style="text;fontStyle=2;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="70" y="486" width="500" height="24" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;Витрина данных (self-service)&lt;/b&gt;&lt;br&gt;контекст: потребление data products,&lt;br&gt;права, отчёты — НЕ владеет данными" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="520" width="300" height="140" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;Интеграционная платформа&lt;/b&gt;&lt;br&gt;контекст: шина, каталог схем, DLQ,&lt;br&gt;антикоррупционные слои к Camel/DWH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=10;" vertex="1" parent="1"><mxGeometry x="420" y="520" width="320" height="140" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;Lakehouse-платформа&lt;/b&gt;&lt;br&gt;контекст: raw/curated хранение,&lt;br&gt;Iceberg, CDC-конвейеры" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=10;" vertex="1" parent="1"><mxGeometry x="780" y="520" width="320" height="140" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;Каталог и governance&lt;/b&gt;&lt;br&gt;контекст: DataHub, политики,&lt;br&gt;линей, качество" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1140" y="520" width="280" height="140" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;Легаси (выводятся)&lt;/b&gt;&lt;br&gt;DWH SQL Server (бизнес-логика), Camel ESB, PowerBuilder —&lt;br&gt;мостируются антикоррупционными слоями" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="820" y="330" width="680" height="130" as="geometry"/></mxCell><mxCell id="n27" value="Правила границ: домены общаются ТОЛЬКО через события (pub/sub) и data products через витрину;&lt;br&gt;«Медицинские данные» — изолированный контекст: публикует наружу только факты без PHI (в аналитику карты не идут — требование кейса);&lt;br&gt;финансовый домен подчиняется банковскому комплаенсу — собственный контур развёртывания; платформенные контексты не владеют бизнес-данными." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FFF9E6;strokeColor=#E6D878;rounded=1;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="720" width="1850" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>